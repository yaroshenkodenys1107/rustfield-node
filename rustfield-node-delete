#!/usr/bin/env bash
# Rustfield.eu node: removes the node from this server: every game server and its files, Wings, the tunnel, the
# settings and this folder. Docker and the firewall stay. First run `rustfield node delete` on the main server.
# Runs only as ./rustfield-node-delete from this folder (no short command, on purpose).
set -euo pipefail

ROOT=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
PROJECT=rustfield-node
# shellcheck source=tools/steps.sh
source "$ROOT/tools/steps.sh"

ARGS=("$@")
STEPS=(need_root need_project_folder no_args delete_begin delete_scan delete_show delete_ask delete_games delete_ours
  delete_networks delete_images delete_files delete_folder delete_done)
run_steps "${STEPS[@]}"
